<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>공공AX-업무매크로</AssemblyName>
    <RootNamespace>Series4.Desktop</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>Public AX Local contributors</Authors>
    <Description>화면 녹화와 입력 이벤트를 함께 기록하고 검토 후 재생하는 Windows 로컬 업무 매크로</Description>
    <RepositoryUrl>https://github.com/obundh/gonggong-ax-local-4</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="SharpHook" Version="7.1.3" />
  </ItemGroup>
</Project>
