<Window x:Class="Series4.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공공 AX 업무 매크로"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F1F3F6"
        FontFamily="Malgun Gothic">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E1E4E8"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#20242A"
                               Text="공공 AX 로컬 4 · 업무 매크로" />
                    <TextBlock x:Name="RecordingStatusText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#6E7781"
                               Text="기록 → 업무 시연 → 종료 → 실행" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Margin="2,0,0,4"
                                   FontSize="10"
                                   Foreground="#667085"
                                   Text="시작 지연" />
                        <ComboBox x:Name="StartDelayComboBox"
                                  Width="76"
                                  Height="30"
                                  Padding="7,0"
                                  ToolTip="키보드 입력이 포함된 매크로는 외부 대상 창을 선택할 수 있도록 최소 3초를 적용합니다."
                                  SelectedIndex="1">
                            <ComboBoxItem Tag="0" Content="즉시" />
                            <ComboBoxItem Tag="3" Content="3초" />
                            <ComboBoxItem Tag="5" Content="5초" />
                            <ComboBoxItem Tag="10" Content="10초" />
                            <ComboBoxItem Tag="30" Content="30초" />
                        </ComboBox>
                    </StackPanel>

                    <Border x:Name="RecordingIndicator"
                            Margin="0,0,14,0"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="#F2F4F7"
                            CornerRadius="16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecordingDot"
                                     Width="8"
                                     Height="8"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"
                                     Fill="#98A2B3" />
                            <TextBlock x:Name="RecordingTimerText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#475467"
                                       Text="대기 중" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="StartRecordingButton"
                            MinWidth="126"
                            Height="42"
                            Padding="18,0"
                            Click="StartRecordingButton_Click"
                            Background="#1769E0"
                            BorderBrush="#1769E0"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Content="● 기록" />

                    <Button x:Name="StopRecordingButton"
                            MinWidth="126"
                            Height="42"
                            Margin="10,0,0,0"
                            Padding="18,0"
                            Click="StopRecordingButton_Click"
                            IsEnabled="False"
                            Background="White"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#B42318"
                            Content="■ 기록 끝" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    Background="White"
                    BorderBrush="#E1E4E8"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Text="업무 시연 영상" />
                        <TextBlock x:Name="VideoStatusText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Text="아직 녹화된 영상이 없습니다." />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="20,0"
                            Background="#111827"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="RecordedVideo"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform" />

                            <Canvas x:Name="EventOverlayCanvas"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />

                            <StackPanel x:Name="VideoPlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="62"
                                        Height="62"
                                        HorizontalAlignment="Center"
                                        Background="#273244"
                                        CornerRadius="31">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="25"
                                               Foreground="#98A2B3"
                                               Text="▶" />
                                </Border>
                                <TextBlock Margin="0,18,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#D0D5DD"
                                           Text="녹화한 업무 영상이 여기에 표시됩니다." />
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#98A2B3"
                                           Text="현재는 주 모니터 전체 화면을 기록합니다." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton"
                                Width="88"
                                Height="36"
                                VerticalAlignment="Center"
                                Click="PlayPauseButton_Click"
                                IsEnabled="False"
                                Background="#F8FAFC"
                                BorderBrush="#D0D5DD"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                 Foreground="#344054"
                                 Content="▶ 재생" />

                        <Button x:Name="RunMacroButton"
                                Grid.Column="1"
                                MinWidth="132"
                                Height="36"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Click="RunMacroButton_Click"
                                IsEnabled="False"
                                Background="#ECFDF3"
                                BorderBrush="#ABEFC6"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                Foreground="#027A48"
                                ToolTip="선택한 시작 지연 후 기록한 입력을 실행합니다."
                                Content="▶ 실행" />

                        <Button x:Name="StopMacroButton"
                                Grid.Column="2"
                                Width="92"
                                Height="36"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Click="StopMacroButton_Click"
                                IsEnabled="False"
                                Background="#FFF6ED"
                                BorderBrush="#F9DBAF"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                Foreground="#B42318"
                                Content="■ 실행 중지" />

                        <Slider x:Name="VideoPositionSlider"
                                Grid.Column="3"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Minimum="0"
                                ValueChanged="VideoPositionSlider_ValueChanged" />

                        <StackPanel Grid.Column="4"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#667085"
                                       Text="배속" />
                            <ComboBox x:Name="PlaybackSpeedComboBox"
                                      Width="72"
                                      Height="32"
                                      Padding="7,0"
                                      IsEnabled="False"
                                      SelectedIndex="2"
                                      SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                                <ComboBoxItem Tag="0.5" Content="0.5×" />
                                <ComboBoxItem Tag="0.75" Content="0.75×" />
                                <ComboBoxItem Tag="1" Content="1.0×" />
                                <ComboBoxItem Tag="1.25" Content="1.25×" />
                                <ComboBoxItem Tag="1.5" Content="1.5×" />
                                <ComboBoxItem Tag="2" Content="2.0×" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="VideoTimeText"
                                   Grid.Column="5"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Text="00:00 / 00:00" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E1E4E8"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A"
                                       Text="이벤트 로그" />
                             <Border Margin="8,0,0,0"
                                     Padding="8,2"
                                     Background="#EEF4FF"
                                    CornerRadius="10">
                                <TextBlock x:Name="EventCountText"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#175CD3"
                                            Text="0" />
                             </Border>
                             <Border x:Name="BlockedCountBadge"
                                     Margin="6,0,0,0"
                                     Padding="8,2"
                                     Background="#FEF3F2"
                                     CornerRadius="10"
                                     Visibility="Collapsed">
                                 <TextBlock x:Name="BlockedCountText"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#B42318"
                                            Text="실패 0" />
                             </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#98A2B3"
                                       Text="실시간" />
                            <Button x:Name="ClearEventsButton"
                                    MinWidth="62"
                                    Height="28"
                                    Padding="9,0"
                                    Click="ClearEventsButton_Click"
                                    IsEnabled="False"
                                    Background="White"
                                    BorderBrush="#D0D5DD"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Foreground="#B42318"
                                    Content="전체 삭제" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="EventLogList"
                             Grid.Row="1"
                             Margin="12,0"
                             Padding="0,8"
                             Background="#F8FAFC"
                             BorderThickness="0"
                             ItemsSource="{Binding RecordedEvents}"
                             KeyDown="EventLogList_KeyDown"
                             SelectionChanged="EventLogList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,9" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="EventBubble"
                                        Margin="8,0,28,0"
                                        Padding="12,10"
                                        Background="White"
                                        BorderBrush="#E4E7EC"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="27" />
                                            <ColumnDefinition Width="27" />
                                            <ColumnDefinition Width="27" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="#98A2B3"
                                                   Text="{Binding TimeText}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Margin="0,0,0,3"
                                                        Orientation="Horizontal">
                                                <TextBlock x:Name="CategoryText"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#175CD3"
                                                           Text="{Binding Category}" />
                                                 <Border x:Name="ExecutableBadge"
                                                         Margin="6,0,0,0"
                                                        Padding="5,1"
                                                        Background="#ECFDF3"
                                                        CornerRadius="6"
                                                        Visibility="Collapsed">
                                                    <TextBlock FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="#027A48"
                                                                Text="실행" />
                                                 </Border>
                                                 <Border x:Name="QuarantineBadge"
                                                         Margin="6,0,0,0"
                                                         Padding="5,1"
                                                         Background="#FEF3F2"
                                                         CornerRadius="6"
                                                         ToolTip="{Binding QuarantineReason}"
                                                         Visibility="Collapsed">
                                                     <TextBlock FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="#B42318"
                                                                Text="실패" />
                                                 </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="#344054"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="QuarantineReasonTextBlock"
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       Foreground="#B42318"
                                                       Text="{Binding QuarantineReason}"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="ExecutionResultTextBlock"
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#027A48"
                                                       Text="{Binding LastExecutionResult}"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Width="24"
                                                Height="24"
                                                Margin="2,-3,0,0"
                                                VerticalAlignment="Top"
                                                Click="MoveEventUpButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="14"
                                                Foreground="#667085"
                                                Tag="{Binding}"
                                                ToolTip="한 칸 위로"
                                                Content="↑" />
                                        <Button Grid.Column="3"
                                                Width="24"
                                                Height="24"
                                                Margin="2,-3,0,0"
                                                VerticalAlignment="Top"
                                                Click="MoveEventDownButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="14"
                                                Foreground="#667085"
                                                Tag="{Binding}"
                                                ToolTip="한 칸 아래로"
                                                Content="↓" />
                                        <Button Grid.Column="4"
                                                Width="24"
                                                Height="24"
                                                Margin="2,-3,-4,0"
                                                VerticalAlignment="Top"
                                                Click="DeleteEventButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="17"
                                                Foreground="#98A2B3"
                                                Tag="{Binding}"
                                                ToolTip="이 이벤트 삭제"
                                                Content="×" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="시스템">
                                        <Setter TargetName="EventBubble" Property="Margin" Value="28,0,8,0" />
                                        <Setter TargetName="EventBubble" Property="Background" Value="#EEF4FF" />
                                        <Setter TargetName="EventBubble" Property="BorderBrush" Value="#B2CCFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="마우스">
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#027A48" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="키보드">
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#B54708" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="수동">
                                        <Setter TargetName="EventBubble" Property="Background" Value="#F4F3FF" />
                                        <Setter TargetName="EventBubble" Property="BorderBrush" Value="#D9D6FE" />
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#6938EF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="경고">
                                        <Setter TargetName="EventBubble" Property="Background" Value="#FFFAEB" />
                                        <Setter TargetName="EventBubble" Property="BorderBrush" Value="#FEDF89" />
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#B54708" />
                                    </DataTrigger>
                                     <DataTrigger Binding="{Binding IsExecutable}" Value="True">
                                         <Setter TargetName="ExecutableBadge"
                                                 Property="Visibility"
                                                 Value="Visible" />
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding IsQuarantined}" Value="True">
                                         <Setter TargetName="QuarantineBadge"
                                                 Property="Visibility"
                                                 Value="Visible" />
                                         <Setter TargetName="EventBubble"
                                                 Property="Background"
                                                 Value="#FFFAFA" />
                                         <Setter TargetName="EventBubble"
                                                 Property="BorderBrush"
                                                 Value="#FDA29B" />
                                         <Setter TargetName="QuarantineReasonTextBlock"
                                                 Property="Visibility"
                                                 Value="Visible" />
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding HasExecutionResult}" Value="True">
                                         <Setter TargetName="ExecutionResultTextBlock"
                                                 Property="Visibility"
                                                 Value="Visible" />
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding LastExecutionFailed}" Value="True">
                                         <Setter TargetName="ExecutionResultTextBlock"
                                                 Property="Foreground"
                                                 Value="#B42318" />
                                     </DataTrigger>
                                 </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyEventHint"
                                Grid.Row="1"
                                Margin="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#344054"
                                   Text="아직 기록된 동작이 없습니다." />
                        <TextBlock Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Text="● 기록을 누른 뒤 메모장 입력이나 그림판 드래그를 해보세요." />
                    </StackPanel>

                    <Expander Grid.Row="2"
                              Padding="14,7"
                              Background="#FCFCFD"
                              BorderBrush="#E4E7EC"
                              BorderThickness="0,1,0,0"
                              Header="고급 편집 · 직접 추가 / 시간 수정"
                              IsExpanded="False">
                    <Border x:Name="ManualEditorPanel"
                            Padding="14,12"
                            Background="#FCFCFD"
                            BorderThickness="0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#20242A"
                                           Text="수동 이벤트 설정" />
                                <TextBlock x:Name="ManualEditorModeText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="#667085"
                                           Text="새 이벤트" />
                            </Grid>

                            <StackPanel Margin="0,9,0,0"
                                        Orientation="Horizontal">
                                <TextBlock Width="76"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="#667085"
                                           Text="실행 동작" />
                                <ComboBox x:Name="ManualActionTypeComboBox"
                                          Width="190"
                                          Height="30"
                                          Padding="7,0"
                                          SelectedIndex="0"
                                          SelectionChanged="ManualActionTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="None" Content="메모만 남기기" />
                                    <ComboBoxItem Tag="TextEntry" Content="텍스트 입력" />
                                    <ComboBoxItem Tag="KeyStroke" Content="키 또는 단축키 입력" />
                                    <ComboBoxItem Tag="MouseLeftClick" Content="실행 시점 왼쪽 클릭" />
                                    <ComboBoxItem Tag="MouseRightClick" Content="실행 시점 오른쪽 클릭" />
                                    <ComboBoxItem Tag="MouseMiddleClick" Content="실행 시점 가운데 클릭" />
                                    <ComboBoxItem Tag="MouseDrag"
                                                  Content="드래그(녹화로 추가)"
                                                  ToolTip="드래그 경로는 화면 녹화 중 마우스로 추가됩니다."
                                                  IsEnabled="False" />
                                    <ComboBoxItem Tag="MouseWheelUp" Content="실행 시점 휠 위" />
                                    <ComboBoxItem Tag="MouseWheelDown" Content="실행 시점 휠 아래" />
                                    <ComboBoxItem Tag="MouseWheelLeft" Content="실행 시점 휠 왼쪽" />
                                    <ComboBoxItem Tag="MouseWheelRight" Content="실행 시점 휠 오른쪽" />
                                </ComboBox>
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="ManualActivityLabelText"
                                               Margin="2,0,0,4"
                                               FontSize="10"
                                               Foreground="#667085"
                                               Text="활동 내용" />
                                    <TextBox x:Name="ManualActivityTextBox"
                                             Height="32"
                                             Padding="8,5"
                                             FontSize="12"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Margin="2,0,0,4"
                                               FontSize="10"
                                               Foreground="#667085"
                                               Text="시점(초)" />
                                    <TextBox x:Name="ManualSecondsTextBox"
                                             Height="32"
                                             Padding="8,5"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Text="0.000"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Height="30"
                                        Padding="9,0"
                                        Click="UseCurrentVideoTimeButton_Click"
                                        Background="White"
                                        BorderBrush="#D0D5DD"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#344054"
                                        Content="현재 재생 시점" />
                                <Button x:Name="UpdateSelectedEventButton"
                                        Grid.Column="2"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Click="UpdateSelectedEventButton_Click"
                                        IsEnabled="False"
                                        Background="White"
                                        BorderBrush="#D0D5DD"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#344054"
                                        Content="선택 수정" />
                                <Button Grid.Column="3"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="11,0"
                                        Click="AddManualEventButton_Click"
                                        Background="#1769E0"
                                        BorderBrush="#1769E0"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Content="새 로그 추가" />
                            </Grid>

                            <TextBlock x:Name="ManualValidationText"
                                       Margin="2,7,0,0"
                                       FontSize="10"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"
                                       Text="로그를 선택하면 내용과 시간을 수정할 수 있습니다." />
                        </StackPanel>
                    </Border>
                    </Expander>

                    <Border Grid.Row="3"
                            BorderBrush="#E4E7EC"
                            BorderThickness="0,1,0,0">
                        <TextBlock Margin="18,6"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#667085"
                                   LineHeight="15"
                                   TextWrapping="Wrap"
                                   Text="로그 클릭: 영상 이동 · ↑↓: 순서 변경 · ×: 삭제 · Ctrl+Shift+F12: 실행 중지" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OutputPathText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#667085"
                       Text="저장 위치: 녹화 후 표시됩니다." />
            <TextBlock x:Name="EmergencyStopText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#98A2B3"
                       Text="긴급 종료: Ctrl + Shift + F12" />
        </Grid>
    </Grid>
</Window>
